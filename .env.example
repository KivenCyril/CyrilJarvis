# =============================================================================
# JARVIS Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Default Model ---
JARVIS_DEFAULT_MODEL=gpt-4o-mini

# --- LLM API Keys (set the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Database (optional, for full docker-compose profile) ---
POSTGRES_PASSWORD=jarvis_dev
DATABASE_URL=
REDIS_URL=

# --- Server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# --- Security ---
JARVIS_SANDBOX_MODE=basic
JARVIS_SECRET_SCANNING=true

# --- Logging ---
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FORMAT=human
